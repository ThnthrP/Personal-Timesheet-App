// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  FOREMAN
  PM
  EXEC
  ACCOUNTING
  ADMIN
}

enum TimesheetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DayType {
  STANDARD
  WEEKEND
  HOLIDAY
}

enum PeriodStatus {
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────
// Auth / Users
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submittedTimesheets Timesheet[] @relation("ForemanTimesheets")
  reviewedTimesheets  Timesheet[] @relation("ReviewedTimesheets")
  returnedTimesheets  Timesheet[] @relation("ReturnedTimesheets")
  reviewedPeriods     PeriodApproval[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Master Data
// ─────────────────────────────────────────────────────────────

model Project {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timesheets Timesheet[]

  @@map("projects")
}

model Trade {
  id            String   @id @default(uuid())
  name          String   @unique
  suggestedRate Decimal? @db.Decimal(10, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  defaultForWorkers Worker[]
  contracts         WorkerContract[]
  timesheetEntries  TimesheetEntry[]

  @@map("trades")
}

model Worker {
  id             String   @id @default(uuid())
  name           String
  defaultTradeId String?
  defaultTrade   Trade?   @relation(fields: [defaultTradeId], references: [id])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contracts        WorkerContract[]
  timesheetEntries TimesheetEntry[]

  @@map("workers")
}

model WorkerContract {
  id         String    @id @default(uuid())
  workerId   String
  worker     Worker    @relation(fields: [workerId], references: [id])
  tradeId    String
  trade      Trade     @relation(fields: [tradeId], references: [id])
  hourlyRate Decimal   @db.Decimal(10, 2)
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([workerId, tradeId, startDate, endDate])
  @@map("worker_contracts")
}

model CalendarOverride {
  date  DateTime @id @db.Date
  type  DayType
  label String?

  @@map("calendar_overrides")
}

// ─────────────────────────────────────────────────────────────
// Timesheet Workflow
// ─────────────────────────────────────────────────────────────

model Timesheet {
  id        String   @id @default(uuid())
  foremanId String
  foreman   User     @relation("ForemanTimesheets", fields: [foremanId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  jobCode   String?
  date      DateTime @db.Date
  dayType   DayType
  notes     String?

  status TimesheetStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("ReviewedTimesheets", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectReason String?

  returnedById String?
  returnedBy   User?     @relation("ReturnedTimesheets", fields: [returnedById], references: [id])
  returnedAt   DateTime?
  returnReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries TimesheetEntry[]

  @@index([status])
  @@index([date])
  @@map("timesheets")
}

model TimesheetEntry {
  id          String    @id @default(uuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  workerId    String
  worker      Worker    @relation(fields: [workerId], references: [id])
  tradeId     String
  trade       Trade     @relation(fields: [tradeId], references: [id])

  startTime String
  endTime   String

  st  Float
  ot1 Float
  ot2 Float

  @@index([workerId, tradeId])
  @@map("timesheet_entries")
}

model PeriodApproval {
  id          String       @id @default(uuid())
  periodStart DateTime     @db.Date
  periodEnd   DateTime     @db.Date
  status      PeriodStatus

  totalCost      Decimal @db.Decimal(12, 2)
  totalHours     Float
  totalST        Float
  totalOT1       Float
  totalOT2       Float
  unpricedHours  Float
  workerCount    Int
  timesheetCount Int

  reviewedById String
  reviewedBy   User     @relation(fields: [reviewedById], references: [id])
  reviewedAt   DateTime
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodStart, periodEnd])
  @@map("period_approvals")
}
